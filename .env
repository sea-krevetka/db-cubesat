# =====================================================
# Конфигурация PostgreSQL
# =====================================================

# Пользователь базы данных
POSTGRES_USER=cubesat_admin

# Пароль базы данных
POSTGRES_PASSWORD=secure_password_123

# Имя базы данных
POSTGRES_DB=cubesat_monitoring

# Путь к данным внутри контейнера
PGDATA=/var/lib/postgresql/data/pgdata


# =====================================================
# Конфигурация pgAdmin
# =====================================================

# Email для входа в pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@cubesat.local

# Пароль для входа в pgAdmin
PGADMIN_DEFAULT_PASSWORD=admin123

# Режим сервера (не менять)
PGADMIN_CONFIG_SERVER_MODE=False


# =====================================================
# Параметры подключения (для справки)
# =====================================================

# Хост для подключения извне (localhost)
DB_HOST=localhost

# Порт PostgreSQL
DB_PORT=5432

# Порт pgAdmin
PGADMIN_PORT=5050